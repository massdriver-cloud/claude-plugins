{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/massdriver-safety-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_massdriver_massdriver|massdriver)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/massdriver-safety-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
